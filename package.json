{
  "name": "gsc-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ابزار تحلیل Google Search Console برای سئوکارهای فارسی‌زبان — کاملاً سمت مرورگر",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --pretty"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
